@inherits LayoutComponentBase

<div class="page">
    <main>
        <div class="top-row px-4">
            <div class="container-fluid">
                <div class="navbar-main" id="mainNav">
                    <ul class="navbar-nav me-auto" style="flex-direction: row">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Initiative tracker</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="miniatures">Miniatures</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="items">Items</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="spells">Spells</NavLink>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="ms-auto d-flex align-items-center" style="margin-right: 80px">
                <ThemeSwitcher/>
            </div>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>