@page "/counter"
@using InitiativeTracker.Integration.RestClients.TtgClub
@using InitiativeTracker.Integration.RestClients.TtgClub.Contracts.V1
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<p>Search bestiary</p>
<InputText @bind-Value="@searchPattern"/>
<button class="btn btn-secondary" @onclick="Search">Search</button>
@if (searchResults == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Source</th>
            <th>Show details</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var result in searchResults)
        {
            <tr>
                <td>@result.Name.Rus</td>
                <td>@result.Source.ShortName</td>
                <td><button class="btn" @onclick="() => GetDetails(result.Url)">Details</button></td>
            </tr>
        }
        </tbody>
    </table>
}
@if (details != null)
{
    <p>@details</p>
}

@inject ILogger<Counter> Logger;
@inject IBestiaryClient BestiaryClient;
@code {
    private int currentCount = 0;

    private string? searchPattern;

    private BestiarySearchResponseItem[]? searchResults;

    private CancellationTokenSource cts = new();

    private string? details;

    private void IncrementCount()
    {
        currentCount++;
        Logger.LogWarning("Some Warning");
    }

    private async Task Search()
    {
        if (string.IsNullOrEmpty(searchPattern))
        {
            searchResults = null;
            return;
        }

        searchResults = await BestiaryClient.SearchV1Async(searchPattern, cts.Token);
    }

    private async Task GetDetails(string url)
    {
        if (string.IsNullOrEmpty(url))
        {
            details = null;
            return;
        }

        details = await BestiaryClient.GetDetailsV1Async(url, cts.Token);
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}