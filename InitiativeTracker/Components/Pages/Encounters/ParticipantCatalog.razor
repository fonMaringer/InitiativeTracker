@rendermode InteractiveServer

@if (_isLoading)
{
    <Spinner Color="SpinnerColor.Primary" Style="width: 30px; height: 30px"/>
}
else
{
        <div class="search-flex-container">
            <div class="search-flex-header">
                <div style="flex: 3;">Name</div>
                <div style="flex: 1;">HP</div>
                <div style="flex: 1;">AC</div>
                <div style="flex: 1;">DEX</div>
                <div style="flex: 1.5;"></div>
            </div>
            <div class="search-flex-body">
                @if (_participants.Any())
                {
                    @foreach (var participant in _participants)
                    {
                        <div class="search-flex-row" @onclick="() => SelectParticipantForEdit(participant.Id)">
                            <div style="flex: 3;">@participant.Name</div>
                            <div style="flex: 1;">@participant.Hits</div>
                            <div style="flex: 1;">@participant.ArmorClass</div>
                            <div style="flex: 1;">@participant.Dexterity</div>
                            <div style="flex: 1.5; display: flex; gap: 5px;" @onclick:stopPropagation="true">
                                <Button Color="ButtonColor.Primary" Size="ButtonSize.ExtraSmall" @onclick="_ => AddToEncounter(participant.Id)"
                                        TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Add to encounter">
                                    <Icon Name="IconName.Plus"/>
                                </Button>
                                <Button Color="ButtonColor.Danger" Size="ButtonSize.ExtraSmall" @onclick="_ => DeleteLibraryParticipant(participant.Id)"
                                        TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Remove from library">
                                    <Icon Name="IconName.Trash"/>
                                </Button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    <div class="add-library-inline" style="display: flex; align-items: center; margin-top: 10px; gap: 5px;">
        <TextInput TValue="string" @bind-Value="_newLibraryName" Style="flex: 3; height: 30px;" placeholder="New participant..."/>
        <NumberInput TValue="int" @bind-Value="_newLibraryHp" Style="flex: 1; height: 30px;" onClick="this.select();"/>
        <NumberInput TValue="int" @bind-Value="_newLibraryAc" Style="flex: 1; height: 30px;" onClick="this.select();"/>
        <NumberInput TValue="int" @bind-Value="_newLibraryDex" Style="flex: 1; height: 30px;" onClick="this.select();"/>
        <div style="flex: 1.5;">
            <Button Color="ButtonColor.Primary" Icon="true" Size="ButtonSize.Small" @onclick="UpsertParticipant" Style="height: 30px;">
                <Icon Name="@(_selectedParticipantId is null ? IconName.Plus : IconName.Save)"/>
            </Button>
        </div>
    </div>
}