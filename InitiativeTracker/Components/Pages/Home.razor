@page "/"
@using InitiativeTracker.Application
@using InitiativeTracker.Domain
@using InitiativeTracker.Integration.RestClients.TtgClub
@using InitiativeTracker.Integration.RestClients.TtgClub.Adapters
@using InitiativeTracker.Integration.RestClients.TtgClub.Contracts.V1
@using Source = InitiativeTracker.Domain.Source

@implements IDisposable;

<PageTitle>Initiative tracker</PageTitle>

<div>
    <h2>Round @InitiativeService.CurrentRound</h2>
</div>

<div class="grid-table" style="grid-template-columns: 100px 175px 500px 300px 100px 75px">
    <div class="grid-header">
        <div></div>
        <div>Initiative</div>
        <div>Name</div>
        <div>HP</div>
        <div>AC</div>
        <div></div>
    </div>
    @foreach (var item in InitiativeService.Items)
    {
        <div class="grid-row @(item.IsDead ? "dead-item" : "") @(item == InitiativeService.Current ? "current-item" : "")">
            <div class="grid-cell">
                <Button Color="ButtonColor.Dark" @onclick="() => InitiativeService.MoveUp(item)"
                        style="margin-right: 5px">
                    <Icon Name="IconName.ArrowUp" Size="IconSize.x6"/>
                </Button>
                <Button Color="ButtonColor.Dark" @onclick="() => InitiativeService.MoveDown(item)">
                    <Icon Name="IconName.ArrowDown" Size="IconSize.x6"/>
                </Button>
            </div>
            <div class="grid-cell">
                <NumberInput TValue="int" @bind-Value="item.Initiative" Style="width: 75px; border-width: 0"/>
                <div style="width: 25px; margin: 0 5px 0 5px">
                    (@(item.DexModifier > 0 ? "+" : "")@item.DexModifier)
                </div>
                <Button Color="ButtonColor.Dark" @onclick="() => item.RollInitiative()" Style="margin-left: 5px">
                    <Icon Name="IconName.ArrowClockwise" Size="IconSize.x6"/>
                </Button>
            </div>
            <div class="grid-cell">
                <TextInput @bind-Value="@item.Name" Style="border-width: 0; margin-right: 5px"/>
                @if (!string.IsNullOrEmpty(item.Link))
                {
                    <Button Color="ButtonColor.Dark" Type="ButtonType.Link" To="@item.Link" Target="Target.Blank">
                        <Icon Name="IconName.Link45Deg" Size="IconSize.x6"/>
                    </Button>
                }
            </div>
            <div class="grid-cell">
                <NumberInput TValue="int" @bind-Value="item.CurrentHp" Style="border-width: 0"/>
                <NumberInput TValue="int" @bind-Value="item.ChangeHpValue" Style="border-width: 0; margin: 0 15px 0 15px"/>
                <Button Color="ButtonColor.Dark" @onclick="() => item.AddHp()" Style="margin-right: 5px">
                    <Icon Name="IconName.Plus" Size="IconSize.x6"/>
                </Button>
                <Button Color="ButtonColor.Dark" @onclick="() => item.RemoveHp()">
                    <Icon Name="IconName.Dash" Size="IconSize.x6"/>
                </Button>
            </div>
            <div class="grid-cell">
                <NumberInput TValue="int" @bind-Value="item.CurrentAc" Style="border-width: 0"/>
            </div>
            <div class="grid-cell">
                <Button Color="ButtonColor.Danger" Outline="true" @onclick="() => InitiativeService.Remove(item)">
                    <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                </Button>
            </div>
        </div>
    }
    
    <div class="grid-row">
        <div></div>
        <div></div>
        <div class="grid-cell">
            <TextInput @bind-Value="_createName"/>
        </div>
        <div class="grid-cell">
            <NumberInput TValue="int" @bind-Value="_createHp"/>
        </div>
        <div class="grid-cell">
            <NumberInput TValue="int" @bind-Value="_createAc"/>
        </div>
        <div class="grid-cell">
            <Button Color="ButtonColor.Primary" @onclick="AddManual">
                <Icon Name="IconName.Plus" Size="IconSize.x6"/>
            </Button>
        </div>
    </div>
</div>

<hr/>

<div>
    <Button Color="ButtonColor.Primary" Outline="true" Class="control-btn" @onclick="() => InitiativeService.Next()">Next</Button>
    <Button Color="ButtonColor.Info" Outline="true" Class="control-btn" @onclick="() => InitiativeService.SortByInitiative()">Sort</Button>
    <Button Color="ButtonColor.Warning" Outline="true" Class="control-btn" @onclick="() => InitiativeService.Restart()">Restart</Button>
    <Button Color="ButtonColor.Danger" Outline="true" Class="control-btn" @onclick="() => InitiativeService.Clear()">Clear</Button>
</div>

<hr/>

<div>
    <h6>Add from bestiary</h6>
    <div style="display: flex">
        <TextInput @bind-Value="@_searchPattern" @onkeyup="OnKeyUpSearch" style="width: 200px; margin-right: 10px"/>
        <Button Color="ButtonColor.Dark" @onclick="Search">
            <Icon Name="IconName.Search" Size="IconSize.x6"/>
        </Button>
    </div>

    @if (_searchResults != null)
    {
        <div class="grid-table" style="grid-template-columns: 400px 100px 150px">
            <div class="grid-header">
                <div>Name</div>
                <div>Source</div>
                <div>Add</div>
            </div>
            @foreach (var result in _searchResults)
            {
                <div class="grid-row">
                    <div class="grid-cell">@result.Name.Rus</div>
                    <div class="grid-cell">@result.Source.ShortName</div>
                    <div class="grid-cell">
                        <NumberInput TValue="int" @bind-Value="result.AddCount" Style="border-width: 0"/>
                        <Button Color="ButtonColor.Dark" @onclick="() => Add(result)">
                            <Icon Name="IconName.Plus" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@inject IBestiaryClient BestiaryClient;
@inject IInitiativeService InitiativeService;

@code
{
    private readonly CancellationTokenSource _cts = new();

    private BestiarySearchResponseItem[]? _searchResults;

    private string? _searchPattern;

    private string _createName;
    private int _createHp;
    private int _createAc;

    private async Task OnKeyUpSearch(KeyboardEventArgs? e)
    {
        if (e?.Code is "Enter" or "NumpadEnter")
        {
            await Search();
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrEmpty(_searchPattern))
        {
            _searchResults = null;
            return;
        }

        _searchResults = await BestiaryClient.SearchV1Async(_searchPattern, _cts.Token);
    }

    private async Task Add(BestiarySearchResponseItem item)
    {
        var url = item.Url;
        if (string.IsNullOrEmpty(url))
        {
            return;
        }

        var details = await BestiaryClient.GetDetailsV1Async(url, _cts.Token);

        var link = BestiaryClient.BuildDirectLink(details.Url);
        for (var i = 0; i < item.AddCount; i++)
        {
            var itemDetails = details.ToInitiativeListItem(link);
            InitiativeService.Append(itemDetails);
        }

        item.AddCount = 1;
    }

    private void AddManual()
    {
        var item = new InitiativeListItem
        {
            Name = _createName,
            Hp = _createHp,
            Ac = _createAc,
            Source = Source.Manual,
        };
        item.Reset();
        
        InitiativeService.Append(item);

        _createName = string.Empty;
        _createHp = 0;
        _createAc = 0;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
