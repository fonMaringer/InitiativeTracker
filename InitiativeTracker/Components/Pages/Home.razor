@page "/"
@rendermode InteractiveServer
@using InitiativeTracker.Application
@using InitiativeTracker.Domain
@using InitiativeTracker.Integration.RestClients.TtgClub
@using InitiativeTracker.Integration.RestClients.TtgClub.Adapters
@using InitiativeTracker.Integration.RestClients.TtgClub.Contracts.V1
@using Source = InitiativeTracker.Domain.Source

@implements IDisposable;

<PageTitle>Initiative tracker</PageTitle>

<div>
    <h2>Round @InitiativeService.CurrentRound</h2>
</div>

<div class="grid-table" style="grid-template-columns: 100px 195px 500px 115px 340px 100px 75px">
    <div class="grid-header">
        <div></div>
        <div>Initiative</div>
        <div>Name</div>
        <div>HP</div>
        <div>Change HP</div>
        <div>AC</div>
        <div></div>
    </div>
    @foreach (var item in InitiativeService.Items)
    {
        <div class="grid-row @(GetItemStyle(item)) @(item == InitiativeService.Current ? "current-item" : "")">
            <div class="grid-cell">
                <Button Color="ButtonColor.Dark" @onclick="() => InitiativeService.MoveUp(item)" style="margin-right: 5px">
                    <Icon Name="IconName.ArrowUp" Size="IconSize.x6"/>
                </Button>
                <Button Color="ButtonColor.Dark" @onclick="() => InitiativeService.MoveDown(item)">
                    <Icon Name="IconName.ArrowDown" Size="IconSize.x6"/>
                </Button>
            </div>
            <div class="grid-cell">
                <NumberInput TValue="int" @bind-Value="item.Initiative" Style="width: 75px; border-width: 0" onClick="this.select();"/>
                <div style="min-width: 35px; margin: 0 5px 0 5px; color: #ccc">
                    <Tooltip Placement="TooltipPlacement.Bottom" Title="Dexterity modifier">
                        (@(item.DexModifier > 0 ? "+" : "")@item.DexModifier)
                    </Tooltip>
                </div>
                <Button Color="ButtonColor.Info" Outline="true" @onclick="() => item.RollInitiative()" Style="margin-left: 5px" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Roll initiative">
                    <Icon Name="IconName.ArrowClockwise" Size="IconSize.x6"/>
                </Button>
            </div>
            <div class="grid-cell">
                <TextInput @bind-Value="@item.Name" Style="border-width: 0; margin-right: 5px"/>
                @if (item.Source is Source.Bestiary)
                {
                    <Button Color="ButtonColor.Dark" Type="ButtonType.Link" To="@item.Link" Target="Target.Blank" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Open in bestiary">
                        <Icon Name="IconName.Link45Deg" Size="IconSize.x6"/>
                    </Button>
                }
            </div>
            <div class="grid-cell">
                <Tooltip Placement="TooltipPlacement.Bottom" Title="@(item.Source is Source.Bestiary ? $"Max HP: {item.HitsAverage}" : "")">
                    <NumberInput TValue="int" @bind-Value="item.HitsCurrent" Style="border-width: 0" onClick="this.select();"/>
                </Tooltip>
            </div>
            <div class="grid-cell">
                <NumberInput TValue="int" @bind-Value="item.ChangeHpValue" Style="border-width: 0; margin-right: 15px" onClick="this.select();"/>
                <Button Color="ButtonColor.Danger" @onclick="() => item.RemoveHp(OperationMode.Full)" Style="margin-right: 5px" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Remove value">
                    <Icon Name="IconName.Dash" Size="IconSize.x6"/>
                </Button>
                <Button Color="ButtonColor.Danger" @onclick="() => item.RemoveHp(OperationMode.Half)" Style="margin-right: 5px" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Remove half value">
                    <div style="display: flex; flex-direction: row;">
                        <Icon Name="IconName.Dash" Size="IconSize.x6"/>
                        <p style="margin: 0">/2</p>
                    </div>
                </Button>
                <Button Color="ButtonColor.Success" @onclick="() => item.AddHp(OperationMode.Full)" Style="margin-right: 5px" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Add value">
                    <Icon Name="IconName.Plus" Size="IconSize.x6"/>
                </Button>
                <Button Color="ButtonColor.Success" @onclick="() => item.AddHp(OperationMode.Half)" Style="margin-right: 5px" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Add half value">
                    <div style="display: flex; flex-direction: row;">
                        <Icon Name="IconName.Plus" Size="IconSize.x6"/>
                        <p style="margin: 0">/2</p>
                    </div>
                </Button>
            </div>
            <div class="grid-cell">
                <Tooltip Placement="TooltipPlacement.Bottom" Title="@(item.Source is Source.Bestiary ? $"Max AC: {item.ArmorClass}" : "")">
                    <NumberInput TValue="int" @bind-Value="item.ArmorClassCurrent" Style="border-width: 0" onClick="this.select();"/>
                </Tooltip>
            </div>
            <div class="grid-cell">
                <Button Color="ButtonColor.Danger" Outline="true" @onclick="() => InitiativeService.Remove(item)" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Remove row">
                    <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                </Button>
            </div>
        </div>
    }
    
    <div class="grid-row">
        <div></div>
        <div></div>
        <div class="grid-cell">
            <TextInput @bind-Value="_createName"/>
        </div>
        <div class="grid-cell">
            <NumberInput TValue="int" @bind-Value="_createHp" onClick="this.select();"/>
        </div>
        <div></div>
        <div class="grid-cell">
            <NumberInput TValue="int" @bind-Value="_createAc" onClick="this.select();"/>
        </div>
        <div class="grid-cell">
            <Button Color="ButtonColor.Primary" @onclick="AddManual" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Add row manually">
                <Icon Name="IconName.Plus" Size="IconSize.x6"/>
            </Button>
        </div>
    </div>
</div>

<hr/>

<div>
    <Button Color="ButtonColor.Primary" Outline="true" Class="control-btn" @onclick="() => InitiativeService.Next()">Next</Button>
    <Button Color="ButtonColor.Info" Outline="true" Class="control-btn" @onclick="() => InitiativeService.SortByInitiative()">Sort</Button>
    <Button Color="ButtonColor.Warning" Outline="true" Class="control-btn" @onclick="() => InitiativeService.Restart()">Restart</Button>
    <Button Color="ButtonColor.Primary" Outline="true" Class="control-btn" @onclick="() => InitiativeService.SaveToFile()">Save</Button>
    <Button Color="ButtonColor.Danger" Outline="true" Class="control-btn" @onclick="() => InitiativeService.Clear()">Clear</Button>
</div>

<hr/>

<div>
    <h6>Add from bestiary</h6>
    <div style="display: flex">
        <TextInput @bind-Value="@_searchPattern" @onkeyup="OnKeyUpSearch" style="width: 200px; margin-right: 10px"/>
        <Button Color="ButtonColor.Dark" @onclick="Search">
            <Icon Name="IconName.Search" Size="IconSize.x6"/>
        </Button>
    </div>

    @if (_searchResults != null)
    {
        <div class="grid-table" style="grid-template-columns: 400px 100px 200px">
            <div class="grid-header">
                <div>Name</div>
                <div>Source</div>
                <div>Add</div>
            </div>
            @foreach (var result in _searchResults)
            {
                <div class="grid-row">
                    <div class="grid-cell">@result.Name.Rus</div>
                    <div class="grid-cell">
                        <Button Color="ButtonColor.None" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="@result.Source.Name">
                            @result.Source.ShortName
                        </Button>
                    </div>
                    <div class="grid-cell">
                        <NumberInput TValue="int" @bind-Value="result.AddCount" Style="border-width: 0" onClick="this.select();"/>
                        <Button Color="ButtonColor.Dark" @onclick="() => Add(result, HitsMode.Average)" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Add with average hits" Style="margin-right: 5px">
                            <Icon Name="IconName.Plus" Size="IconSize.x6"/>
                        </Button>
                        <Button Color="ButtonColor.Dark" @onclick="() => Add(result, HitsMode.Random)" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Add with randomized hits">
                            <Icon Name="IconName.Dice5" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@inject IBestiaryClient BestiaryClient;
@inject IInitiativeService InitiativeService;

@code
{
    private readonly CancellationTokenSource _cts = new();

    private BestiarySearchResponseItem[]? _searchResults;

    private string? _searchPattern;

    private string _createName = string.Empty;
    private int _createHp;
    private int _createAc;

    private async Task OnKeyUpSearch(KeyboardEventArgs? e)
    {
        if (e?.Code is "Enter" or "NumpadEnter")
        {
            await Search();
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrEmpty(_searchPattern))
        {
            _searchResults = null;
            return;
        }

        _searchResults = await BestiaryClient.SearchV1Async(_searchPattern, _cts.Token);
    }

    private async Task Add(BestiarySearchResponseItem item, HitsMode hitsMode)
    {
        var url = item.Url;
        if (string.IsNullOrEmpty(url))
        {
            return;
        }

        var details = await BestiaryClient.GetDetailsV1Async(url, _cts.Token);
        
        if (details is null)
            return;

        var link = BestiaryClient.BuildDirectLink(details.Url);
        for (var i = 0; i < item.AddCount; i++)
        {
            var itemDetails = details.ToInitiativeListItem(link, hitsMode);
            InitiativeService.Append(itemDetails);
        }

        item.AddCount = 1;
    }

    private void AddManual()
    {
        var item = new InitiativeListItem
        {
            Name = _createName,
            HitsAverage = _createHp,
            ArmorClass = _createAc,
            Source = Source.Manual,
        };
        item.Initialize(HitsMode.Average);
        
        InitiativeService.Append(item);

        _createName = string.Empty;
        _createHp = 0;
        _createAc = 0;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
    
    private static string GetItemStyle(InitiativeListItem item)
    {
        switch (item.State)
        {
            case HealthState.Healthy:
                return "healthy-item";
            case HealthState.SlightlyWounded:
                return "slightly-wounded-item";
            case HealthState.Wounded:
                return "wounded-item";
            case HealthState.SeriouslyWounded:
                return "seriously-wounded-item";
            case HealthState.Dead:
                return "dead-item";
            default:
                throw new ArgumentOutOfRangeException(nameof(item.State), item.State, null);
        }
    }
}
