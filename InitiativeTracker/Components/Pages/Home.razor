@page "/"
@rendermode InteractiveServer
@using InitiativeTracker.Components.Pages.Encounters

<PageTitle>Initiative Tracker</PageTitle>

<div class="dashboard-layout">
    <div class="encounters-column">
        <h5>Encounters</h5>
        <EncounterCatalog @ref="_encounterCatalogRef" OnSelectEncounter="OnSelectEncounter"/>
    </div>

    <div class="main-content-column">
        <div class="tracker-section">
            <InitiativeTracker @ref="_initiativeTrackerRef"/>
        </div>

        <div class="integration-panel" style="display: flex; gap: 20px;">
            <div class="search-bestiary-section" style="flex: 1;">
                <h6>Add from Bestiary</h6>
                <BestiarySearch OnAddToEncounter="@OnAddToEncounter"/>
            </div>
            <div class="library-section" style="flex: 1;">
                <h6>Participant catalog</h6>
                <ParticipantCatalog OnAddToEncounter="@OnAddToEncounter"/>
            </div>
        </div>

    </div>
</div>
