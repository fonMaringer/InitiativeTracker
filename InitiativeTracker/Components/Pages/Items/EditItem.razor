@rendermode InteractiveServer
@using InitiativeTracker.Application
@using InitiativeTracker.Application.Dtos
@using InitiativeTracker.Domain.Entities
@using InitiativeTracker.Domain

<div class="border rounded p-3 mb-2">
    <h4>Edit: @Item.Name</h4>

    @if (_isProcessing)
    {
        <Spinner Color="SpinnerColor.Primary" Style="margin-bottom: 15px; width: 30px; height: 30px"/>
    }

    <div class="mb-2">
        <label class="form-label"><b>Name</b></label>
        <InputText @bind-Value="_name" class="form-control"/>
    </div>

    <div class="mb-2">
        <label class="form-label"><b>Rarity</b></label>
        <select class="form-select" @bind="_rarity">
            @foreach (var option in _rarityOptions)
            {
                <option value="@option">@option</option>
            }
        </select>
    </div>

    <div class="mb-2 form-check">
        <InputCheckbox @bind-Value="_requiresAttunement" class="form-check-input"/>
        <label class="form-check-label"><b>Requires Attunement</b></label>
    </div>

    <div class="mb-2">
        <label class="form-label"><b>Description</b></label>
        <InputTextArea @bind-Value="_description" class="form-control" rows="6"/>
        <p class="text-muted" style="font-size: 0.8em;">HTML markup is supported.</p>
    </div>

    <Button Color="ButtonColor.Primary" Disabled="@_isProcessing" Class="me-2" @onclick="OnSave">
        Save
    </Button>
    <Button Color="ButtonColor.Danger" Disabled="@_isProcessing" @onclick="OnCloseRequested">
        Cancel
    </Button>

    @if (_errorMessage != null)
    {
        <Alert ShowDismissButton="true" Color="AlertColor.Danger" Style="margin-top: 10px;">@_errorMessage</Alert>
    }
</div>

@code
{
    [Parameter] public ItemEntity Item { get; set; } = default!;

    private string _name = string.Empty;
    private ItemRarity _rarity;
    private bool _requiresAttunement;
    private string _description = string.Empty;
    private bool _isProcessing;
    private string? _errorMessage;

    private readonly ItemRarity[] _rarityOptions = Enum.GetValues<ItemRarity>().ToArray();

    [Inject] IItemService ItemService { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    protected override void OnInitialized()
    {
        _name = Item.Name;
        _rarity = Item.Rarity;
        _requiresAttunement = Item.RequiresAttunement;
        _description = Item.Description;
    }

    private async Task OnSave()
    {
        await SaveInternal();
    }

    public async Task SaveAndRefresh()
    {
        await SaveInternal();
    }

    private async Task SaveInternal()
    {
        _isProcessing = true;
        _errorMessage = null;

        try
        {
            await ItemService.UpdateAsync(Item.Id, new ItemUpdateDto(
                Name: _name,
                Rarity: _rarity,
                RequiresAttunement: _requiresAttunement,
                Description: _description));

            Item.Name = _name;
            Item.Rarity = _rarity;
            Item.RequiresAttunement = _requiresAttunement;
            Item.Description = _description;

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to update item: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task OnCloseRequested()
    {
        await OnClosed.InvokeAsync();
    }
}
