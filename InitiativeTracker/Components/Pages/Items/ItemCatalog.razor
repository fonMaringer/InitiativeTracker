@rendermode InteractiveServer
@using InitiativeTracker.Application
@using InitiativeTracker.Domain.Entities

<div>
    <div class="mb-3" style="display: flex; align-items: center;">
        <TextInput @bind-Value="_searchQuery" @onkeyup="OnKeyUpSearch" Style="width: 300px; margin-right: 10px"/>
        <Button Color="ButtonColor.Dark" @onclick="(_ => _onSearch())">
            <Icon Name="IconName.Search" Size="IconSize.x6"/>
        </Button>
    </div>

    @if (_isLoading)
    {
        <Spinner Color="SpinnerColor.Primary" Style="width: 30px; height: 30px"/>
    }
    else if (_items.Count == 0)
    {
        <p class="text-muted">No items found. Add some first.</p>
    }
    else
    {
        <div class="row mb-2">
            <div class="col-md-5">Name</div>
            <div class="col-md-2">Printed count</div>
        </div>
        @foreach (var item in _items)
        {
            <div class="row mb-2 align-items-center catalog-row" style="cursor: pointer;" @onclick="() => SelectForEdit(item)">
                <div class="col-md-5">
                    <b>
                        @if (item.Link is not null)
                        {
                            <a href="@item.Link" target="_blank">@item.Name</a>
                        }
                        else
                        {
                            @item.Name
                        }
                    </b>
                    <span class="badge bg-secondary ms-2">@item.Rarity</span>
                    @if (item.RequiresAttunement)
                    {
                        <span class="badge bg-warning text-dark ms-1">Attunement</span>
                    }
                </div>
                <div class="col-md-2">
                    @(item.PrintedCount)
                </div>
                <div class="col-md-2 d-flex gap-1 align-items-center justify-content-end" @onclick:stopPropagation="true">
                    <Button Color="ButtonColor.Success" Outline="true" Size="ButtonSize.Small" @onclick="() => OnAddToPrint(item)"
                            TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Add to print list">
                        <Icon Name="IconName.Printer" Size="IconSize.x6"/>
                    </Button>
                    <Button Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small"
                            @onclick="() => OnDelete(item)">
                        <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                    </Button>
                </div>
            </div>
        }
    }
</div>

@code
{
    private List<ItemEntity> _items = new();
    private bool _isLoading;
    private string _searchQuery = string.Empty;

    [Inject] IItemService ItemService { get; set; } = default!;
    [Parameter] public EventCallback<ItemEntity?> OnEditSelected { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public EventCallback<ItemEntity> OnAddForPrint { get; set; }

    private volatile bool _isSearching;
    private int _pendingSearchVersion;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllItems();
    }

    public async Task RefreshAsync()
    {
        _searchQuery = string.Empty;
        await LoadAllItems();
    }

    private async Task LoadAllItems()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var allItems = await ItemService.SearchAsync(string.Empty);
            _items = new List<ItemEntity>(allItems);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load catalog: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnKeyUpSearch(KeyboardEventArgs? e)
    {
        if (e?.Code is "Enter" or "NumpadEnter")
        {
            await _onSearch();
        }
    }

    private async Task _onSearch()
    {
        if (_isSearching) return;
        var version = Interlocked.Increment(ref _pendingSearchVersion);
        _isSearching = true;
        try
        {
            _isLoading = true;
            StateHasChanged();
            var results = await ItemService.SearchAsync(_searchQuery);
            if (version == _pendingSearchVersion)
                _items = new List<ItemEntity>(results);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to search items: {ex.Message}");
            StateHasChanged();
        }
        finally
        {
            _isLoading = false;
            _isSearching = false;
        }
    }

    private async Task SelectForEdit(ItemEntity item)
    {
        await OnEditSelected.InvokeAsync(item);
    }

    private async Task OnAddToPrint(ItemEntity item)
    {
        await OnAddForPrint.InvokeAsync(item);
    }

    private async Task OnDelete(ItemEntity item)
    {
        try
        {
            await ItemService.DeleteAsync(item.Id);
            _items.Remove(item);
            StateHasChanged();
            await OnDataChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to delete item: {ex.Message}");
        }
    }

    private string Truncate(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;

        var stripped = System.Text.RegularExpressions.Regex.Replace(text, "<.*?>", string.Empty);
        return stripped.Substring(0, maxLength) + "...";
    }
}
