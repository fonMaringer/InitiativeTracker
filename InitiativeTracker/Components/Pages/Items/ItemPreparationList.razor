@rendermode InteractiveServer
@using InitiativeTracker.Application
@using InitiativeTracker.Application.PrintHtmlGenerators
@using InitiativeTracker.Domain.Entities

<div>
    @if (_printItems.Count == 0)
    {
        <p class="text-muted">No items in the print list. Use the catalog to add items.</p>
    }
    else
    {
        <div class="grid-table" style="grid-template-columns: 250px 100px 80px 80px">
            <div class="grid-header">
                <div>Name</div>
                <div>Rarity</div>
                <div>Qty</div>
                <div></div>
            </div>
            @foreach (var printItem in _printItems)
            {
                <div class="grid-row">
                    <div class="grid-cell">@printItem.Item.Name</div>
                    <div class="grid-cell">@printItem.Item.Rarity</div>
                    <div class="grid-cell">
                        <NumberInput TValue="int" 
                                     @bind-Value="@printItem.Quantity"
                                    Style="width: 60px; border-width: 0" onClick="this.select();"/>
                    </div>
                    <div class="grid-cell">
                        <Button Color="ButtonColor.Danger" Outline="true" @onclick="() => RemoveFromPrintList(printItem.Item.Id)">
                            <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
        <hr/>
        <Button Color="ButtonColor.Primary" @onclick="GeneratePrintHtml">Generate Print HTML</Button>
    }

    @if (_printHtml != null)
    {
        <Alert ShowDismissButton="true" Color="AlertColor.Info" Style="margin-top: 10px; white-space: pre-wrap;">
            @_printHtml
        </Alert>
    }
</div>

@code
{
    List<PrintListItemEntry> _printItems = new();
    string? _printHtml;

    readonly ItemPrintGenerator _printGenerator = new();

    public void AddItem(ItemEntity item, int quantity)
    {
        if (quantity <= 0) return;

        var entry = _printItems.FirstOrDefault(p => p.Item.Id == item.Id);
        if (entry != null)
        {
            entry.Quantity += quantity;
        }
        else
        {
            _printItems.Add(new PrintListItemEntry(item, quantity));
        }

        StateHasChanged();
    }

    void RemoveFromPrintList(int itemId)
    {
        _printItems.RemoveAll(p => p.Item.Id == itemId);
        StateHasChanged();
    }

    void GeneratePrintHtml()
    {
        var printDataList = new List<ItemPrintDataDto>();

        foreach (var printItem in _printItems)
        {
            var entity = printItem.Item;

            for (int n = 0; n < printItem.Quantity; n++)
            {
                printDataList.Add(new ItemPrintDataDto(
                    Name: entity.Name,
                    Rarity: entity.Rarity,
                    RequiresAttunement: entity.RequiresAttunement,
                    DescriptionHtml: entity.Description));
            }
        }

        _printHtml = _printGenerator.Generate(printDataList);
    }

    public class PrintListItemEntry(ItemEntity item, int quantity)
    {
        public ItemEntity Item { get; } = item;
        public int Quantity { get; set; } = quantity;
    }
}
