@page "/items"
@rendermode InteractiveServer
@using InitiativeTracker.Domain.Entities

<PageTitle>Items</PageTitle>

<div>
    <h2>Items</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-4">
                <h5>Item list (click to edit)</h5>
                <ItemCatalog @key="_catalogKey" OnEditSelected="@OnEditSelected" OnDataChanged="@InvalidateCatalog" OnAddForPrint="@OnAddForPrint" />
            </div>
        </div>

        <div class="col-md-4">
            <div class="mb-4">
                <AddItemForm OnDataChanged="InvalidateCatalog" EditItem="@_editItem" OnEditItemChanged="OnEditItemChanged" />
            </div>
        </div>

        <div class="col-md-4">
            <div>
                <h5>Print cards</h5>
                <ItemPreparationList @ref="PreparationListRef" />
            </div>
        </div>
    </div>
</div>

@code
{
    private int _catalogKey;
    private ItemEntity? _editItem;
    private ItemPreparationList? PreparationListRef;

    private Task OnEditSelected(ItemEntity? item) => OnEditItemChanged(item);

    private async Task OnEditItemChanged(ItemEntity? item)
    {
        _editItem = item;
        StateHasChanged();
    }

    private void InvalidateCatalog()
    {
        _catalogKey++;
    }

    private async Task OnAddForPrint(ItemEntity item)
    {
        PreparationListRef?.AddItem(item, 1);
        StateHasChanged();
    }
}
