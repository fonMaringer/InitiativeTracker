@page "/items"
@rendermode InteractiveServer

<PageTitle>Items</PageTitle>

<div>
    <h2>Items</h2>

    <div class="mb-4">
        <h5>Item list</h5>
        <ItemCatalog />
    </div>

    <hr />

    <div class="mb-4">
        <h5>Add item</h5>
        <AddItemForm OnItemAdded="OnItemAdded" />
    </div>

    <hr />

    <div>
        <h5>Print cards</h5>
        <ItemPreparationList />
    </div>
</div>

@code
{
    private Task OnItemAdded()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
