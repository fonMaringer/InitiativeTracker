@page "/items"
@rendermode InteractiveServer

<PageTitle>Предметы</PageTitle>

<div>
    <h2>Предметы</h2>

    <Tabs>
        <TabItem Text="Каталог предметов" Display="TabDisplay.Button">
            <ItemCatalog />
        </TabItem>
        <TabItem Text="Добавить предмет" Display="TabDisplay.Button">
            <AddItemForm OnItemAdded="OnItemAdded" />
        </TabItem>
        <TabItem Text="Подготовка к печати" Display="TabDisplay.Button">
            <ItemPreparationList />
        </TabItem>
    </Tabs>
</div>

@code
{
    private Task OnItemAdded()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
