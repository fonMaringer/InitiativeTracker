@rendermode InteractiveServer

<div>
    <div class="mb-3" style="display: flex; align-items: center;">
        <TextInput @bind-Value="_searchQuery" @onkeyup="OnKeyUpSearch" Style="width: 300px; margin-right: 10px"/>
        <Button Color="ButtonColor.Dark" @onclick="(_ => _onSearch())">
            <Icon Name="IconName.Search" Size="IconSize.x6"/>
        </Button>
    </div>

    @if (_isLoading)
    {
        <Spinner Color="SpinnerColor.Primary" Style="width: 30px; height: 30px"/>
    }
    else if (_miniatures.Count == 0)
    {
        <p class="text-muted">No miniatures found. Add some first.</p>
    }
    else
    {
        <div class="catalog-scroll-area d-flex flex-column">
            <div class="catalog-header d-flex mb-2">
                <div style="flex: 0.5">Name</div>
                <div style="flex: 0.25">Image</div>
                <div style="flex: 0.15">Printed count</div>
                <div style="flex: 0.1"></div>
            </div>
            @foreach (var miniature in _miniatures)
            {
                <div class="d-flex align-items-center catalog-row mb-2" style="cursor: pointer;"
                     @onclick="() => SelectForEdit(miniature)">
                    <div style="flex: 0.5;">
                        @if (miniature.Link is not null)
                        {
                            <a href="@miniature.Link" target="_blank">@miniature.Name</a>
                        }
                        else
                        {
                            @miniature.Name
                        }
                        <span class="badge bg-secondary ms-2">@miniature.Size</span>
                    </div>
                    <div style="flex: 0.25;" @onclick:stopPropagation="true">
                        @if (miniature.CroppedImageData is { Length: > 0 } imgSrc)
                        {
                            <div style="width:50px; height:64px; overflow:hidden; position:relative;">
                                <img src="data:image/png;base64,@Convert.ToBase64String(imgSrc)"
                                     alt="@miniature.Name"
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     @onclick:stopPropagation="true"/>
                            </div>
                        }
                    </div>
                    <div style="flex: 0.15;">
                        @(miniature.PrintedCount)
                    </div>
                    <div class="d-flex gap-1 align-items-center justify-content-end" style="flex: 0.1;"
                         @onclick:stopPropagation="true">
                        <Button Color="ButtonColor.Success" Outline="true" Size="ButtonSize.Small"
                                @onclick="() => OnAddToPrint(miniature)"
                                TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Add to print list">
                            <Icon Name="IconName.Printer" Size="IconSize.x6"/>
                        </Button>
                        <Button Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small"
                                @onclick="() => OnDelete(miniature)">
                            <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
    }
</div>
