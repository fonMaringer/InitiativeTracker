@rendermode InteractiveServer

<div>
    @if (_printItems.Count == 0)
    {
        <p class="text-muted">No miniatures in the print list. Use the catalog to add miniatures.</p>
    }
    else
    {
        <div class="catalog-scroll-area d-flex flex-column">
            <div class="catalog-header d-flex mb-2">
                <div style="flex: 0.5">Image</div>
                <div style="flex: 2">Name</div>
                <div style="flex: 0.8">Size</div>
                <div style="flex: 0.6">Qty</div>
                <div style="flex: 0.5"></div>
            </div>
            @foreach (var printItem in _printItems)
            {
                <div class="d-flex align-items-center catalog-row mb-2">
                    <div style="flex: 0.5;">
                        @if (_images.TryGetValue(printItem.Miniature.Id, out var imgSrc))
                        {
                            <div style="width:50px; height:64px; overflow:hidden; position:relative;">
                                <img src="@imgSrc"
                                     alt="@printItem.Miniature.Name"
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     @onclick:stopPropagation="true"/>
                            </div>
                        }
                    </div>
                    <div style="flex: 2">@printItem.Miniature.Name</div>
                    <div style="flex: 0.8">@printItem.Miniature.Size</div>
                    <div style="flex: 0.6">
                        <NumberInput TValue="int" 
                                     @bind-Value="@printItem.Quantity"
                                     Style="width: 60px; border-width: 0" onClick="this.select();"/>
                    </div>
                    <div style="flex: 0.5;">
                        <Button Color="ButtonColor.Danger" Outline="true" @onclick="() => RemoveFromPrintList(printItem.Miniature.Id)">
                            <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
        <hr/>
        <Button Color="ButtonColor.Primary" @onclick="GenerateAndOpenPrintHtml">Preview and Print</Button>
        <p class="text-muted" style="font-size: 0.8em;">Better print on A4 with minimal fields</p>
    }
</div>