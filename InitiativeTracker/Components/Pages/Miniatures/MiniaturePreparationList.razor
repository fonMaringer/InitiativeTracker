@rendermode InteractiveServer
@using System.Globalization
@using InitiativeTracker.Application.PrintHtmlGenerators
@using InitiativeTracker.Domain.Entities

<div>
    @if (_printItems.Count == 0)
    {
        <p class="text-muted">No miniatures in the print list. Use the catalog to add miniatures.</p>
    }
    else
    {
        <div class="grid-table" style="grid-template-columns: 80px 1fr 100px 80px 80px; width: 100%;">
            <div class="grid-header">
                <div></div>
                <div>Name</div>
                <div>Size</div>
                <div>Qty</div>
                <div></div>
            </div>
            @foreach (var printItem in _printItems)
            {
                <div class="grid-row">
                    <div class="grid-cell">
                        @if (_images.TryGetValue(printItem.Miniature.Id, out string? imgSrc))
                        {
                            <div style="width:50px; height:64px; overflow:hidden; position:relative;">
                                <img src="@imgSrc"
                                     alt="@printItem.Miniature.Name"
                                     style="@BuildCropStyle(printItem.Miniature)"
                                     @onclick:stopPropagation="true"/>
                            </div>
                        }
                    </div>
                    <div class="grid-cell">@printItem.Miniature.Name</div>
                    <div class="grid-cell">@printItem.Miniature.Size</div>
                    <div class="grid-cell">
                        <NumberInput TValue="int" 
                                     @bind-Value="@printItem.Quantity"
                                    Style="width: 60px; border-width: 0" onClick="this.select();"/>
                    </div>
                    <div class="grid-cell">
                        <Button Color="ButtonColor.Danger" Outline="true" @onclick="() => RemoveFromPrintList(printItem.Miniature.Id)">
                            <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
        <hr/>
        <Button Color="ButtonColor.Primary" @onclick="GenerateAndOpenPrintHtml">Preview and Print</Button>
    }
</div>

@inject Microsoft.JSInterop.IJSRuntime JSRuntime;

@code
{

    List<PrintListMiniatureEntry> _printItems = new();
    readonly Dictionary<int, string> _images = new();

    readonly MiniaturePrintGenerator _printGenerator = new();

    public void AddItem(MiniatureEntity miniature, int quantity)
    {
        if (quantity <= 0) return;

        var entry = _printItems.FirstOrDefault(p => p.Miniature.Id == miniature.Id);
        if (entry != null)
        {
            entry.Quantity += quantity;
        }
        else
        {
            _printItems.Add(new PrintListMiniatureEntry(miniature, quantity));
            if (miniature.ImageData != null && miniature.ImageData.Length > 0)
            {
                _images[miniature.Id] = $"data:image/png;base64,{Convert.ToBase64String(miniature.ImageData)}";
            }
        }

        StateHasChanged();
    }

    void RemoveFromPrintList(int miniatureId)
    {
        _printItems.RemoveAll(p => p.Miniature.Id == miniatureId);
        StateHasChanged();
    }

    async Task GenerateAndOpenPrintHtml()
    {
        var printDataList = new List<MiniaturePrintDataDto>();

        foreach (var printItem in _printItems)
        {
            var entity = printItem.Miniature;
            var imageBase64 = entity.ImageData != null ? Convert.ToBase64String(entity.ImageData) : string.Empty;

            printDataList.Add(new MiniaturePrintDataDto(
                Name: entity.Name,
                Size: entity.Size,
                Quantity: printItem.Quantity,
                ImageBase64: imageBase64,
                CropXOffset: entity.CropXOffset,
                CropYOffset: entity.CropYOffset,
                CropZoom: entity.CropZoom));
        }

        string html = _printGenerator.Generate(printDataList);
        await JSRuntime.InvokeVoidAsync("openHtmlInNewTab", html);
    }

    public class PrintListMiniatureEntry(MiniatureEntity miniature, int quantity)
    {
        public MiniatureEntity Miniature { get; } = miniature;
        public int Quantity { get; set; } = quantity;
    }

    private static string BuildCropStyle(MiniatureEntity m)
    {
        float cx = m.CropXOffset ?? 0f;
        float cy = m.CropYOffset ?? 0f;
        float cz = MathF.Max(1f, m.CropZoom ?? 1f);

        // Width/height % are relative to container dims. translate() % are relative to element size.
        // This correctly handles arbitrary image aspect ratios and crop regions outside image bounds (Vm0).
        string wPct = (cz * 100).ToString("F4", CultureInfo.InvariantCulture);
        string tx = (-cx * 100).ToString("F4", CultureInfo.InvariantCulture);
        string ty = (-cy * 100).ToString("F4", CultureInfo.InvariantCulture);
        return $"width:{wPct}%; height:auto; display:block; position:absolute; transform-origin:top left; transform:translate({tx}%,{ty}%);";
    }
}
