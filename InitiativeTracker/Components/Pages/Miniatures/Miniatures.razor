@page "/miniatures"
@rendermode InteractiveServer

<PageTitle>Miniatures</PageTitle>

<div>
    <h2>Miniatures</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-4">
                <h5>Miniature list (click to edit)</h5>
                <MiniatureCatalog @key="_catalogKey" OnEditSelected="@OnEditSelected" OnDataChanged="@InvalidateCatalog" OnAddForPrint="@OnAddForPrint" />
            </div>
        </div>

        <div class="col-md-4">
            <div class="mb-4">
                <AddMiniatureForm OnDataChanged="InvalidateCatalog" EditMiniature="@_editMiniature" OnEditMiniatureChanged="OnEditMiniatureChanged" />
            </div>
        </div>

        <div class="col-md-4">
            <div>
                <h5>Print miniatures</h5>
                <MiniaturePreparationList @ref="PreparationListRef" />
            </div>
        </div>
    </div>
</div>

