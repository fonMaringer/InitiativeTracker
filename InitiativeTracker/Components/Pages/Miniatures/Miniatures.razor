@page "/miniatures"
@rendermode InteractiveServer

<PageTitle>Miniatures</PageTitle>

<div>
    <h2>Miniatures</h2>

    <div class="mb-4">
        <h5>Miniature list</h5>
        <MiniatureCatalog />
    </div>

    <hr />

    <div class="mb-4">
        <h5>Add miniature</h5>
        <AddMiniatureForm OnMiniatureAdded="OnMiniatureAdded" />
    </div>

    <hr />

    <div>
        <h5>Print miniatures</h5>
        <PreparationList />
    </div>
</div>

@code
{
    private Task OnMiniatureAdded()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
