@page "/miniatures"
@rendermode InteractiveServer

<PageTitle>Миниатюры</PageTitle>

<div>
    <h2>Миниатюры</h2>

    <Tabs>
        <TabItem Text="Каталог миниатюр" Display="TabDisplay.Button">
            <MiniatureCatalog />
        </TabItem>
        <TabItem Text="Добавить миниатюру" Display="TabDisplay.Button">
            <AddMiniatureForm OnMiniatureAdded="OnMiniatureAdded" />
        </TabItem>
        <TabItem Text="Подготовка к печати" Display="TabDisplay.Button">
            <PreparationList />
        </TabItem>
    </Tabs>
</div>

@code
{
    private Task OnMiniatureAdded()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
