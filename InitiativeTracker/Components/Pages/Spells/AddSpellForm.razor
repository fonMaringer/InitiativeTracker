@rendermode InteractiveServer

<div>
    <h5>@(_editSpell != null ? "Edit spell" : "Add spell")</h5>

    @if (_isProcessing)
    {
        <Spinner Color="SpinnerColor.Primary" Style="margin-bottom: 15px; width: 30px; height: 30px"/>
    }

    @if (_editSpell == null)
    {
        <div style="margin-bottom: 15px;">
            <h6>Search in ttg.club</h6>
            <div style="display: flex">
                <TextInput @bind-Value="@_searchPattern" @onkeyup="OnKeyUpSearch" style="width: 300px; margin-right: 10px"/>
                <Button Color="ButtonColor.Dark" @onclick="SearchSpells">
                    <Icon Name="IconName.Search" Size="IconSize.x6"/>
                </Button>
            </div>

            @if (_searchResults != null)
            {
                <div class="grid-table" style="grid-template-columns: 300px 80px 120px 100px; margin-top: 10px;">
                    <div class="grid-header">
                        <div>Name</div>
                        <div>Level</div>
                        <div>School</div>
                        <div>Select</div>
                    </div>
                    @foreach (var result in _searchResults)
                    {
                        <div class="grid-row">
                            <div class="grid-cell">@result.Name.Rus</div>
                            <div class="grid-cell">@(result.Level == 0 ? "Cantrip" : result.Level)</div>
                            <div class="grid-cell">@result.School</div>
                            <div class="grid-cell">
                                <Button Color="ButtonColor.Dark" @onclick="() => SelectSpell(result)" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Select to fill form fields">
                                    <Icon Name="IconName.Check" Size="IconSize.x6"/>
                                </Button>
                                <Button Color="ButtonColor.Dark" @onclick="() => SaveFromItem(result)" TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Select to save">
                                    <Icon Name="IconName.Plus" Size="IconSize.x6"/>
                                </Button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="mb-2" style="display: flex; gap: 10px;">
        <div style="flex: 1;">
            <label class="form-label"><b>Name</b></label>
            <InputText @bind-Value="_name" class="form-control"/>
        </div>
        <div style="flex: 1;">
            <label class="form-label"><b>Link</b></label>
            <InputText @bind-Value="_link" class="form-control"/>
        </div>
    </div>

    <div class="mb-2" style="display: flex; gap: 10px;">
        <div style="flex: 1;">
            <label class="form-label"><b>Type (School)</b></label>
            <InputText @bind-Value="_type" class="form-control"/>
        </div>
        <div style="flex: 1;">
            <label class="form-label"><b>Level</b></label>
            <NumberInput TValue="int" Min="0" Max="9" @bind-Value="_level" class="form-control"/>
        </div>
    </div>

    <div class="mb-2" style="display: flex; gap: 10px;">
        <div style="flex: 1;">
            <label class="form-label"><b>Casting Time</b></label>
            <InputText @bind-Value="_time" class="form-control"/>
        </div>
        <div style="flex: 1;">
            <label class="form-label"><b>Range</b></label>
            <InputText @bind-Value="_range" class="form-control"/>
        </div>
        <div style="flex: 1;">
            <label class="form-label"><b>Duration</b></label>
            <InputText @bind-Value="_duration" class="form-control"/>
        </div>
    </div>

    <div class="mb-2 form-check">
        <InputCheckbox @bind-Value="_concentration" class="form-check-input"/>
        <label class="form-check-label"><b>Concentration</b></label>
    </div>

    <div class="mb-2" style="display: flex; gap: 10px; align-items: center;">
        <div class="form-check" style="display: flex; gap: 4px;">
            <InputCheckbox @bind-Value="_verbalComponent" class="form-check-input"/>
            <label class="form-check-label"><b>Verbal (V)</b></label>
        </div>
        <div class="form-check" style="display: flex; gap: 4px;">
            <InputCheckbox @bind-Value="_somaticComponent" class="form-check-input"/>
            <label class="form-check-label"><b>Somatic (S)</b></label>
        </div>
        <div class="form-check" style="display: flex; gap: 4px;">
            <InputCheckbox @bind-Value="_materialComponentEnabled" class="form-check-input"/>
            <label class="form-check-label"><b>Material (M)</b></label>
        </div>
        @if (_materialComponentEnabled)
        {
            <InputText @bind-Value="_materialComponent" class="form-control" style="flex: 1; margin-left: auto;"/>
        }
    </div>

    <div class="mb-2">
        <label class="form-label"><b>Classes</b></label>
        <div style="display: flex; gap: 5px; margin-bottom: 5px; flex-wrap: wrap;">
            @foreach (var cls in _classes)
            {
                <span class="badge bg-secondary d-inline-flex align-items-center gap-1 px-3 py-2">
                    @cls
                    <Icon Name="IconName.X" Size="IconSize.x6" Style="cursor: pointer;" @onclick="() => RemoveClass(cls)"/>
                </span>
            }
        </div>
        <div style="display: flex; gap: 5px;">
            <InputText @bind-Value="_classInput" class="form-control" @onkeyup="OnKeyUpAddClass" Placeholder="Enter class name"/>
            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="AddClass">
                <Icon Name="IconName.Plus" Size="IconSize.x6"/>
            </Button>
        </div>
    </div>

    <div class="mb-2">
        <label class="form-label"><b>Subclasses</b></label>
        <div style="display: flex; gap: 5px; margin-bottom: 5px; flex-wrap: wrap;">
            @foreach (var subcls in _subclasses)
            {
                <span class="badge bg-secondary d-inline-flex align-items-center gap-1 px-3 py-2">
                    @subcls
                    <Icon Name="IconName.X" Size="IconSize.x6" Style="cursor: pointer;" @onclick="() => RemoveSubclass(subcls)"/>
                </span>
            }
        </div>
        <div style="display: flex; gap: 5px;">
            <InputText @bind-Value="_subclassInput" class="form-control" @onkeyup="OnKeyUpAddSubclass" Placeholder="Enter subclass name"/>
            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="AddSubclass">
                <Icon Name="IconName.Plus" Size="IconSize.x6"/>
            </Button>
        </div>
    </div>

    <div class="mb-2">
        <label class="form-label"><b>Description</b></label>
        <InputTextArea @bind-Value="_description" class="form-control" rows="6"/>
        <p class="text-muted" style="font-size: 0.8em;">HTML markup is supported.</p>
    </div>

    <div class="mb-2">
        <label class="form-label"><b>Printed count</b></label>
        <NumberInput TValue="int?" Min="0" @bind-Value="_printedCount" class="form-control"/>
    </div>

    <Button Color="ButtonColor.Primary" Disabled="@_isDisabled" Class="me-2" @onclick="OnSave">
        @(_editSpell != null ? "Save" : "Add Spell")
    </Button>
    @if (_editSpell != null)
    {
        <Button Color="ButtonColor.Secondary" @onclick="OnCancel">
            Cancel
        </Button>
    }

    @if (_errorMessage != null)
    {
        <Alert ShowDismissButton="true" Color="AlertColor.Danger" Style="margin-top: 10px;">@_errorMessage</Alert>
    }

    @if (_successMessage != null)
    {
        <Alert ShowDismissButton="true" Color="AlertColor.Success" Style="margin-top: 10px;">@_successMessage</Alert>
    }
</div>
