@using InitiativeTracker.Application
@using InitiativeTracker.Application.Dtos
@using InitiativeTracker.Domain.Entities
@using InitiativeTracker.Domain

<div class="border rounded p-3 mb-2">
    <h4>Edit: @Spell.Name</h4>

    @if (_isProcessing)
    {
        <Spinner Color="SpinnerColor.Primary" Style="margin-bottom: 15px; width: 30px; height: 30px"/>
    }

    <div class="mb-2">
        <label class="form-label"><b>Name</b></label>
        <InputText @bind-Value="_name" class="form-control"/>
    </div>

    <div class="mb-2">
        <label class="form-label"><b>Class</b></label>
        <select class="form-select" @bind="_spellClass">
            @foreach (var option in _classOptions)
            {
                <option value="@((int)option)">@option</option>
            }
        </select>
    </div>

    <div class="mb-2 form-check">
        <InputCheckbox @bind-Value="_verbalComponent" class="form-check-input"/>
        <label class="form-check-label"><b>Verbal (V)</b></label>
    </div>

    <div class="mb-2 form-check">
        <InputCheckbox @bind-Value="_somaticComponent" class="form-check-input"/>
        <label class="form-check-label"><b>Somatic (S)</b></label>
    </div>

    <div class="mb-2 form-check">
        <InputCheckbox @bind-Value="_materialComponent" class="form-check-input"/>
        <label class="form-check-label"><b>Material (M)</b></label>
    </div>

    <div class="mb-2">
        <label class="form-label"><b>Description</b></label>
        <InputTextArea @bind-Value="_description" class="form-control" rows="6"/>
        <p class="text-muted" style="font-size: 0.8em;">HTML markup is supported.</p>
    </div>

    <Button Color="ButtonColor.Primary" Disabled="@_isProcessing" Class="me-2" @onclick="OnSave">
        Save
    </Button>
    <Button Color="ButtonColor.Danger" Disabled="@_isProcessing" @onclick="OnCloseRequested">
        Cancel
    </Button>

    @if (_errorMessage != null)
    {
        <Alert ShowDismissButton="true" Color="AlertColor.Danger" Style="margin-top: 10px;">@_errorMessage</Alert>
    }
</div>

@code
{
    [Parameter] public SpellEntity Spell { get; set; } = default!;

    private string _name = string.Empty;
    private SpellClass _spellClass;
    private bool _verbalComponent;
    private bool _somaticComponent;
    private bool _materialComponent;
    private string _description = string.Empty;
    private bool _isProcessing;
    private string? _errorMessage;

    private readonly SpellClass[] _classOptions = Enum.GetValues<SpellClass>().ToArray();

    [Inject] ISpellService SpellService { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    protected override void OnInitialized()
    {
        _name = Spell.Name;
        _spellClass = Spell.Class;
        _verbalComponent = Spell.VerbalComponent;
        _somaticComponent = Spell.SomaticComponent;
        _materialComponent = Spell.MaterialComponent;
        _description = Spell.Description;
    }

    private async Task OnSave()
    {
        await SaveInternal();
    }

    public async Task SaveAndRefresh()
    {
        await SaveInternal();
    }

    private async Task SaveInternal()
    {
        _isProcessing = true;
        _errorMessage = null;

        try
        {
            await SpellService.UpdateAsync(Spell.Id, new SpellUpdateDto(
                Name: _name,
                VerbalComponent: _verbalComponent,
                SomaticComponent: _somaticComponent,
                MaterialComponent: _materialComponent,
                Class: _spellClass,
                Description: _description));

            Spell.Name = _name;
            Spell.Class = _spellClass;
            Spell.VerbalComponent = _verbalComponent;
            Spell.SomaticComponent = _somaticComponent;
            Spell.MaterialComponent = _materialComponent;
            Spell.Description = _description;

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to update spell: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task OnCloseRequested()
    {
        await OnClosed.InvokeAsync();
    }
}
