@using InitiativeTracker.Application
@using InitiativeTracker.Domain.Entities

<div>
    <div class="mb-3">
        <label class="form-label"><b>Поиск заклинания</b></label>
        <TextInput @bind-Value="_searchQuery" Style="width: 300px; margin-right: 10px"/>
        <Button Color="ButtonColor.Dark" @onclick="Search">
            <Icon Name="IconName.Search" Size="IconSize.x6"/>
        </Button>
    </div>

    @if (_searchResults != null)
    {
        <div class="grid-table" style="grid-template-columns: 200px 150px 80px 300px">
            <div class="grid-header">
                <div>Name</div>
                <div>Class</div>
                <div>Qty</div>
                <div></div>
            </div>
            @foreach (var spell in _searchResults)
            {
                <div class="grid-row">
                    <div class="grid-cell">@spell.Name</div>
                    <div class="grid-cell">@spell.Class</div>
                    <div class="grid-cell">
                        @if (_quantities.TryGetValue(spell.Id, out int currentQty))
                        {
                            <NumberInput TValue="int" Value="@currentQty" ValueChanged="@(v => _quantities[spell.Id] = v)" Style="width: 60px; border-width: 0" onClick="this.select();"/>
                        }
                    </div>
                    <div class="grid-cell">
                        <Button Color="ButtonColor.Success" Outline="true" Disabled="@(!_canAdd(spell.Id))" @onclick="() => AddToPrintList(spell)">
                            <Icon Name="IconName.Plus" Size="IconSize.x6"/> Add to print
                        </Button>
                    </div>
                </div>
            }
        </div>
    }

    @if (_printItems.Count > 0)
    {
        <hr/>
        <h4>List for printing</h4>
        <div class="grid-table" style="grid-template-columns: 250px 120px 80px 80px">
            <div class="grid-header">
                <div>Name</div>
                <div>Class</div>
                <div>Qty</div>
                <div></div>
            </div>
            @foreach (var printItem in _printItems)
            {
                var spellName = GetSpellName(printItem.SpellId);
                var spellClass = GetSpellClass(printItem.SpellId);
                <div class="grid-row">
                    <div class="grid-cell">@spellName</div>
                    <div class="grid-cell">@spellClass</div>
                    <div class="grid-cell">@printItem.Quantity</div>
                    <div class="grid-cell">
                        <Button Color="ButtonColor.Danger" Outline="true" @onclick="() => RemoveFromPrintList(printItem.SpellId)">
                            <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
        <hr/>
        <Button Color="ButtonColor.Primary" @onclick="GeneratePrintHtml">Generate Print HTML</Button>
    }

    @if (_printHtml != null)
    {
        <Alert ShowDismissButton="true" Color="AlertColor.Info" Style="margin-top: 10px; white-space: pre-wrap;">
            @_printHtml
        </Alert>
    }
</div>

@code
{
    private string _searchQuery = string.Empty;
    private IReadOnlyList<SpellEntity>? _searchResults;
    private readonly Dictionary<int, int> _quantities = new();
    private List<(int SpellId, int Quantity)> _printItems = new();
    private string? _printHtml;

    [Inject] ISpellService SpellService { get; set; } = default!;

    private async Task Search()
    {
        _searchResults = await SpellService.SearchAsync(_searchQuery);
        foreach (var spell in _searchResults)
        {
            if (!_quantities.ContainsKey(spell.Id))
                _quantities[spell.Id] = 1;
        }
    }

    private bool _canAdd(int id)
    {
        return _quantities.TryGetValue(id, out int qty) && qty > 0;
    }

    private void AddToPrintList(SpellEntity spell)
    {
        if (!_quantities.TryGetValue(spell.Id, out int quantity) || quantity <= 0)
            return;

        var existingIndex = _printItems.FindIndex(p => p.SpellId == spell.Id);
        if (existingIndex >= 0)
        {
            var oldItem = _printItems[existingIndex];
            _printItems[existingIndex] = (oldItem.SpellId, oldItem.Quantity + quantity);
        }
        else
        {
            _printItems.Add((spell.Id, quantity));
        }
    }

    private void RemoveFromPrintList(int spellId)
    {
        _printItems.RemoveAll(p => p.SpellId == spellId);
    }

    private string GetSpellName(int spellId)
    {
        var spell = _searchResults?.FirstOrDefault(s => s.Id == spellId);
        return spell?.Name ?? $"Spell #{spellId}";
    }

    private string GetSpellClass(int spellId)
    {
        var spell = _searchResults?.FirstOrDefault(s => s.Id == spellId);
        return spell?.Class.ToString() ?? "";
    }

    private void GeneratePrintHtml()
    {
    }
}
