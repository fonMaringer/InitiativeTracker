@rendermode InteractiveServer
@using InitiativeTracker.Application
@using InitiativeTracker.Application.PrintHtmlGenerators
@using InitiativeTracker.Domain.Entities

<div>
    @if (_printItems.Count == 0)
    {
        <p class="text-muted">No spells in the print list. Use the catalog to add spells.</p>
    }
    else
    {
        <div class="grid-table" style="grid-template-columns: 250px 120px 80px 80px">
            <div class="grid-header">
                <div>Name</div>
                <div>Class</div>
                <div>Qty</div>
                <div></div>
            </div>
            @foreach (var printItem in _printItems)
            {
                <div class="grid-row">
                    <div class="grid-cell">@printItem.Spell.Name</div>
                    <div class="grid-cell">@printItem.Spell.Class</div>
                    <div class="grid-cell">
                        <NumberInput TValue="int" 
                                     @bind-Value="@printItem.Quantity"
                                    Style="width: 60px; border-width: 0" onClick="this.select();"/>
                    </div>
                    <div class="grid-cell">
                        <Button Color="ButtonColor.Danger" Outline="true" @onclick="() => RemoveFromPrintList(printItem.Spell.Id)">
                            <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
        <hr/>
        <Button Color="ButtonColor.Primary" @onclick="GeneratePrintHtml">Generate Print HTML</Button>
    }

    @if (_printHtml != null)
    {
        <Alert ShowDismissButton="true" Color="AlertColor.Info" Style="margin-top: 10px; white-space: pre-wrap;">
            @_printHtml
        </Alert>
    }
</div>

@code
{
    List<PrintListSpellEntry> _printItems = new();
    string? _printHtml;

    readonly SpellPrintGenerator _printGenerator = new();

    public void AddItem(SpellEntity spell, int quantity)
    {
        if (quantity <= 0) return;

        var entry = _printItems.FirstOrDefault(p => p.Spell.Id == spell.Id);
        if (entry != null)
        {
            entry.Quantity += quantity;
        }
        else
        {
            _printItems.Add(new PrintListSpellEntry(spell, quantity));
        }

        StateHasChanged();
    }

    void RemoveFromPrintList(int spellId)
    {
        _printItems.RemoveAll(p => p.Spell.Id == spellId);
        StateHasChanged();
    }

    void GeneratePrintHtml()
    {
        var printDataList = new List<SpellPrintDataDto>();

        foreach (var printItem in _printItems)
        {
            var entity = printItem.Spell;

            for (int n = 0; n < printItem.Quantity; n++)
            {
                printDataList.Add(new SpellPrintDataDto(
                    Name: entity.Name,
                    VerbalComponent: entity.VerbalComponent,
                    SomaticComponent: entity.SomaticComponent,
                    MaterialComponent: entity.MaterialComponent,
                    SpellClass: entity.Class,
                    DescriptionHtml: entity.Description));
            }
        }

        _printHtml = _printGenerator.Generate(printDataList);
    }

    public class PrintListSpellEntry(SpellEntity spell, int quantity)
    {
        public SpellEntity Spell { get; } = spell;
        public int Quantity { get; set; } = quantity;
    }
}
