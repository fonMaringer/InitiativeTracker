@rendermode InteractiveServer

<div>
    @if (_printItems.Count == 0)
    {
        <p class="text-muted">No spells in the print list. Use the catalog to add spells.</p>
    }
    else
    {
        <div class="grid-table" style="grid-template-columns: 1fr 80px 80px; width: 100%;">
            <div class="grid-header">
                <div>Name</div>
                <div>Qty</div>
                <div></div>
            </div>
            @foreach (var printItem in _printItems)
            {
                <div class="grid-row">
                    <div class="grid-cell">@printItem.Spell.Name</div>
                    <div class="grid-cell">
                        <NumberInput TValue="int" 
                                     @bind-Value="@printItem.Quantity"
                                    Style="width: 60px; border-width: 0" onClick="this.select();"/>
                    </div>
                    <div class="grid-cell">
                        <Button Color="ButtonColor.Danger" Outline="true" @onclick="() => RemoveFromPrintList(printItem.Spell.Id)">
                            <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
        <hr/>
        <Button Color="ButtonColor.Primary" @onclick="GenerateAndOpenPrintHtml">Preview and Print</Button>
        <p class="text-muted" style="font-size: 0.8em;">Better print on A4 with minimal fields</p>
    }
</div>

