@page "/spells"
@rendermode InteractiveServer

<PageTitle>Заклинания</PageTitle>

<div>
    <h2>Заклинания</h2>

    <Tabs>
        <TabItem Text="Каталог заклинаний" Display="TabDisplay.Button">
            <SpellCatalog />
        </TabItem>
        <TabItem Text="Добавить заклинание" Display="TabDisplay.Button">
            <AddSpellForm OnSpellAdded="OnSpellAdded" />
        </TabItem>
        <TabItem Text="Подготовка к печати" Display="TabDisplay.Button">
            <SpellPreparationList />
        </TabItem>
    </Tabs>
</div>

@code
{
    private Task OnSpellAdded()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
