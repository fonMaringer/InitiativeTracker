@page "/spells"
@rendermode InteractiveServer
@using InitiativeTracker.Domain.Entities

<PageTitle>Spells</PageTitle>

<div>
    <h2>Spells</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-4">
                <h5>Spell list (click to edit)</h5>
                <SpellCatalog @key="_catalogKey" OnEditSelected="@OnEditSelected" OnDataChanged="@InvalidateCatalog" OnAddForPrint="@OnAddForPrint" />
            </div>
        </div>

        <div class="col-md-4">
            <div class="mb-4">
                <AddSpellForm OnDataChanged="InvalidateCatalog" EditSpell="@_editSpell" OnEditSpellChanged="OnEditSpellChanged" />
            </div>
        </div>

        <div class="col-md-4">
            <div>
                <h5>Print cards</h5>
                <SpellPreparationList @ref="PreparationListRef" />
            </div>
        </div>
    </div>
</div>

@code
{
    private int _catalogKey;
    private SpellEntity? _editSpell;
    private SpellPreparationList? PreparationListRef;

    private Task OnEditSelected(SpellEntity? spell) => OnEditSpellChanged(spell);

    private async Task OnEditSpellChanged(SpellEntity? spell)
    {
        _editSpell = spell;
        StateHasChanged();
    }

    private void InvalidateCatalog()
    {
        _catalogKey++;
    }

    private async Task OnAddForPrint(SpellEntity spell)
    {
        PreparationListRef?.AddItem(spell, 1);
        StateHasChanged();
    }
}
