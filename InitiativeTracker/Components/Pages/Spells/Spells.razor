@page "/spells"
@rendermode InteractiveServer

<PageTitle>Spells</PageTitle>

<div>
    <h2>Spells</h2>

    <div class="mb-4">
        <h5>Spell list</h5>
        <SpellCatalog />
    </div>

    <hr />

    <div class="mb-4">
        <h5>Add spell</h5>
        <AddSpellForm OnSpellAdded="OnSpellAdded" />
    </div>

    <hr />

    <div>
        <h5>Print cards</h5>
        <SpellPreparationList />
    </div>
</div>

@code
{
    private Task OnSpellAdded()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
