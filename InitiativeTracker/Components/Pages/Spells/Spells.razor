@page "/spells"
@rendermode InteractiveServer

<PageTitle>Spells</PageTitle>

<div>
    <h2>Spells</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-4">
                <h5>Spell list (click to edit)</h5>
                <SpellCatalog @ref="Catalog" OnEditSelected="@OnEditSelected" OnDataChanged="@InvalidateCatalog" OnAddForPrint="@OnAddForPrint" />
            </div>
        </div>

        <div class="col-md-4">
            <div class="mb-4">
                <AddSpellForm OnDataChanged="InvalidateCatalog" EditSpell="@_editSpell" OnEditSpellChanged="OnEditSpellChanged" />
            </div>
        </div>

        <div class="col-md-4">
            <div>
                <h5>Print cards</h5>
                <SpellPreparationList @ref="PreparationListRef" />
            </div>
        </div>
    </div>
</div>

