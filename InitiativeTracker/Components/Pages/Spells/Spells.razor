@page "/spells"
@rendermode InteractiveServer

<PageTitle>Spells</PageTitle>

<div>
    <h2>Spells</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-4">
                <h5>Spell list</h5>
                <SpellCatalog />
            </div>
        </div>

        <div class="col-md-4">
            <div class="mb-4">
                <h5>Add spell</h5>
                <AddSpellForm OnSpellAdded="OnSpellAdded" />
            </div>
        </div>

        <div class="col-md-4">
            <div>
                <h5>Print cards</h5>
                <SpellPreparationList />
            </div>
        </div>
    </div>
</div>

@code
{
    private Task OnSpellAdded()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
