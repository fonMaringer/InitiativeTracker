@rendermode InteractiveServer

<div>
    @if (_isLoading)
    {
        <Spinner Color="SpinnerColor.Primary" Style="width: 30px; height: 30px"/>
    }
    else if (_stands.Count == 0)
    {
        <p class="text-muted">No stands found. Add some first.</p>
    }
    else
    {
        <div class="catalog-scroll-area d-flex flex-column">
            <div class="catalog-header d-flex mb-2">
                <div style="flex: 0.7">Image</div>
                <div style="flex: 0.2">Inverse text color</div>
                <div style="flex: 0.1"></div>
            </div>
            @foreach (var stand in _stands)
            {
                <div class="d-flex align-items-center catalog-row mb-2" style="cursor: pointer;"
                     @onclick="() => SelectForEdit(stand)">
                    <div style="flex: 0.7;" @onclick:stopPropagation="true">
                        @if (stand.ImageData is { Length: > 0 } imgSrc)
                        {
                            <div style="width:50px; height:64px; overflow:hidden; position:relative;">
                                <img src="data:image/png;base64,@Convert.ToBase64String(imgSrc)"
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     @onclick:stopPropagation="true"/>
                            </div>
                        }
                    </div>
                    <div style="flex: 0.2;" @onclick:stopPropagation="true">
                        @if (stand.InverseTextColor)
                        {
                            <Icon Name="IconName.CheckCircle" Size="IconSize.x6"/>
                        }
                        else
                        {
                            <Icon Name="IconName.XCircle" Size="IconSize.x6"/>
                        }
                    </div>
                    <div class="d-flex gap-1 align-items-center justify-content-end" style="flex: 0.1;"
                         @onclick:stopPropagation="true">
                        <Button Color="ButtonColor.Success" Outline="true" Size="ButtonSize.Small"
                                @onclick="() => OnAddToPrint(stand)"
                                TooltipPlacement="TooltipPlacement.Bottom" TooltipTitle="Add to print list">
                            <Icon Name="IconName.Printer" Size="IconSize.x6"/>
                        </Button>
                        <Button Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small"
                                @onclick="() => OnDelete(stand)">
                            <Icon Name="IconName.Trash" Size="IconSize.x6"/>
                        </Button>
                    </div>
                </div>
            }
        </div>
    }
</div>
